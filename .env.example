# ---------------------------------------------------------------------------
# TrustFlow environment
# Copy to `.env` and fill in. `.env` is gitignored -- never commit a real key.
# ---------------------------------------------------------------------------

# Deployer key. For local Anvil this is account #0 and is safe to use as-is.
# For Monad testnet, use a throwaway key funded from the Monad faucet.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Monad testnet RPC (chain id 10143).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: an extra wallet the deploy script funds with 50,000 vUSD so a judge
# can borrow immediately without visiting the faucet.
# DEMO_WALLET=0x0000000000000000000000000000000000000000

# Optional: contract verification on the Monad explorer.
# MONAD_EXPLORER_API_KEY=
# MONAD_EXPLORER_API_URL=https://testnet.monadexplorer.com/api

# ---------------------------------------------------------------------------
# Frontend (web/.env.local) -- all optional.
# Addresses are normally baked in by `make abi` from contracts/deployments/.
# Set these only to point the UI at a deployment you did not deploy yourself.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_POOL_ADDRESS=
# NEXT_PUBLIC_ORACLE_ADDRESS=
# NEXT_PUBLIC_VUSD_ADDRESS=
